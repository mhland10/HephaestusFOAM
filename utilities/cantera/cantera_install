#!/bin/bash
set -e

#==================================================================================================
#
#  Set up required variables
#
#==================================================================================================

# --- Versions ---
CANTERA_VERSION="2.6.0"          # or "2.6.1", "2.6.2"
INSTALL_DIR="$HOME/cantera-$CANTERA_VERSION"
BUILD_DIR=$CANT_HOME

# --- C++ & Build Flags ---
export CXXFLAGS="-std=c++14"
export CC=gcc
export CXX=g++

#==================================================================================================
#
#  Install dependencies
#
#==================================================================================================

# --- Dependencies ---
sudo apt update
sudo apt install -y \
    g++ gfortran scons python3-dev python3-numpy python3-yaml \
    libboost-all-dev libeigen3-dev \
    git
    
#==================================================================================================
#
#  Download Cantera
#
#==================================================================================================

mkdir -p $INSTALL_DIR && cd $INSTALL_DIR

# Clone the exact version
git clone https://github.com/Cantera/cantera.git
cd cantera
git fetch --tags
git checkout "v$CANTERA_VERSION"

#==================================================================================================
#
#  Configure SCONS and install
#
#==================================================================================================

# --- Configure Build ---
# Disable Python module if only C++ is needed (set yes if needed)
scons build \
    prefix=$BUILD_DIR \
    optimize=y \
    debug=n \
    python_package=n \
    f90_interface=n \
    system_eigen=y


# --- Install ---
sudo scons install > cantera_install.log

#==================================================================================================
#
#  Readout
#
#==================================================================================================

# --- Verification ---
strings /opt/cantera/lib/libcantera.so | grep std=
# should show: -std=c++14

grep CANTERA_VERSION /opt/cantera/include/cantera/base/config.h
# should show: 2.6.0

# --- Environment Setup ---
echo "
# ===== Cantera $CANTERA_VERSION =====
export CANTERA_ROOT=$INSTALL_DIR
export PATH=\$CANTERA_ROOT/bin:\$PATH
export LD_LIBRARY_PATH=\$CANTERA_ROOT/lib/x86_64-linux-gnu:\$CANTERA_ROOT/lib:\$LD_LIBRARY_PATH
export PYTHONPATH=\$CANTERA_ROOT/lib/python3/site-packages:\$PYTHONPATH
" >> ~/.bashrc

echo "? Cantera $CANTERA_VERSION installed to $INSTALL_DIR"

rm -rf $INSTALL_DIR
